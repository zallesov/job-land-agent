# Combined stack env — lives on the host at /docker/joblandagent/.env (never committed).
# No PORT here: dashboard (3000) and mcp (8787) get theirs from image defaults /
# the mcp service block. PocketBase URL is the public one for the dashboard;
# the mcp service overrides it to the internal http://pocketbase:8090.

# Dashboard (client bundle is baked at build time; server reads these at runtime)
NEXT_PUBLIC_POCKETBASE_URL=https://pb.zall.dev
POCKETBASE_URL=https://pb.zall.dev
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me

# Shared PocketBase admin creds (dashboard + mcp)
POCKETBASE_ADMIN_EMAIL=you@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# MCP bootstrap bearer token
MCP_API_TOKEN=change-me
