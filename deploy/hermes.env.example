# Hermes agent stack env — lives ONLY on the hermes host at
# /docker/hermes-workspace-dwys/.env (never committed). Template only.
#
# Compose project name defaults to the directory name (hermes-workspace-dwys);
# the traefik router/host is "<project>.<TRAEFIK_HOST>".
TRAEFIK_HOST=zall.dev

# Hermes gateway API + dashboards.
API_SERVER_KEY=
HERMES_PASSWORD=
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Model providers (set whichever the agent uses).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Telegram bridge.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# PocketBase (agent reaches it via https://pb.zall.dev / MCP).
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# Jobland MCP server bearer token.
MCP_JOBLAND_API_KEY=
